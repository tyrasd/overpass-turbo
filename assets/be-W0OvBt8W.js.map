    "help.wizard.tags.key": "аб'екты, якія маюць <i>ключ</i> тэга, з любым значэннем",
    "help.wizard.tags.nokey": "аб'екты, у якіх няма <i>ключа</i> тэга",
    "help.wizard.tags.like": "аб'екты, значэнне <i>ключа</i> якіх адпавядае рэгулярнаму выразу (дадайце <i>/i</i>, каб ігнараваць рэгістр)",
    "help.wizard.tags.likelike": "аб'екты, у якіх і ключ, і значэнне адпавядаюць рэгулярнаму выразу",
    "help.wizard.tags.notlike": "аб'екты, значэнне <i>ключа</i> якіх не адпавядае рэгулярнаму выразу",
    "help.wizard.tags.substr": "аб'екты, значэнне <i>ключа</i> якіх утрымлівае <i>значэнне</i>",
